{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": false,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "capabilities": [
        "default"
      ],
      "csp": {
        "connect-src": "'self' https://gitee.com",
        "default-src": "'self'",
        "font-src": "'self'",
        "img-src": "'self' blob: data: asset: http://asset.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    },
    "windows": [
      {
        "center": true,
        "closable": true,
        "decorations": false,
        "dragDropEnabled": true,
        "focus": true,
        "fullscreen": false,
        "height": 950,
        "maximizable": true,
        "minHeight": 950,
        "minWidth": 1600,
        "minimizable": true,
        "resizable": true,
        "shadow": true,
        "title": "Steam Tool Plus",
        "transparent": false,
        "visible": true,
        "width": 1600
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "identifier": "com.steamtoolplus.app",
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "productName": "Steam Tool Plus",
  "version": "1.30.2"
}